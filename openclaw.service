[Unit]
Description=OpenClaw - bot Discord pour Claude Code
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Desktop/openclaw-setup
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
